# --- required ---
JWT_SECRET=change-me-to-a-long-random-string
GROQ_API_KEY=gsk_your_key_from_console.groq.com

# --- AI model (must support image input; check console.groq.com/docs/vision) ---
GROQ_MODEL=qwen/qwen3.8-27b

# --- rules ---
MAX_RETURNS=5        # user is blocked after MORE than this many returns
RETURN_DAYS=7        # days after delivery that a damage report is allowed

# --- admin: the account registered with this email becomes admin ---
ADMIN_EMAIL=you@example.com

# --- real email delivery (leave SMTP_HOST empty to only store mails in the in-app mailbox) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="DamageGuard <you@gmail.com>"

PORT=3000
